{
    "version": "2.0.0",
    "tasks": [
        {
            // Um nome geral para a tarefa
            "label": "Build & Run Project (Universal)",

            // --- SEÇÃO PARA WINDOWS ---
            // Este bloco só será usado se o VS Code estiver rodando no Windows
            "windows": {
                "command": "gcc",
                "args": [
                    "-g",
                    "-o", "urna.exe",
                    "main.c",
                    "Buscas/buscaBinaria.c",
                    "Buscas/buscaSequencial.c",
                    "Entities/administrador.c",
                    "Entities/candidato.c",
                    "Entities/eleitor.c",
                    "Entities/pessoa.c",
                    "Util/util.c"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                },
                "problemMatcher": ["$gcc"]},

            // --- SEÇÃO PARA LINUX (e macOS) ---
            // Este bloco só será usado no Linux ou macOS
            "linux": {
                "command": "gcc -g -o ${workspaceFolder}/urna.exe ${workspaceFolder}/main.c ${workspaceFolder}/Entities/*.c ${workspaceFolder}/Buscas/*.c ${workspaceFolder}/Util/*.c && ${workspaceFolder}/urna.exe",
            },
            "osx": {
                "command": "gcc -g -o ${workspaceFolder}/urna.exe ${workspaceFolder}/main.c ${workspaceFolder}/Entities/*.c ${workspaceFolder}/Buscas/*.c ${workspaceFolder}/Util/*.c && ${workspaceFolder}/urna.exe",
            },

            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}